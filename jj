    'command_injection': [
        r"(\bwget\b)", r"(\bcurl\b)", r"(\bnc\b)", r"(\bbash\b)",
        r"(&&.*rm)", r"(;\s*cat)", r"(\$\{.*\})",
    ],
}

def detect_attack(request_data, request_path, request_headers):
    threats = []
    check_data = f"{request_path}?{request_data}&{dict(request_headers)}"
    check_data = check_data.lower()

    for attack_type, patterns in ATTACK_PATTERNS.items():
        for pattern in patterns:
            if re.search(pattern, check_data, re.I):
                threats.append(attack_type)
                break

    # rate limit detection
    ip = get_client_ip()
    current = time.time()
    recent = [v for v in visitors if v.get('ip') == ip and current - v.get('time', 0) < 10]
    if len(recent) > 20:
        threats.append('rate_limit/ddos')

    return list(set(threats))

def get_client_ip():
    if request.headers.get('X-Forwarded-For'):
        return request.headers.get('X-Forwarded-For').split(',')[0].strip()
    elif request.headers.get('X-Real-IP'):
        return request.headers.get('X-Real-IP')
    return request.remote_addr

def get_ip_info(ip):
    try:
        r = requests.get(f'http://ip-api.com/json/{ip}?fields=66846719', timeout=5)
        if r.status_code == 200:
            return r.json()
    except:
        pass
    return {}

